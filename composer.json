{
    "name": "idkollen/client",
    "description": "PHP client for the IDkollen REST API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Default HTTP client (auto-discovered if installed)"
    },
    "autoload": {
        "psr-4": {
            "Idkollen\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Idkollen\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": "php -l src/"
    }
}
