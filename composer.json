{
    "name": "identisure/client",
    "description": "PHP client for the Identisure REST API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "guzzlehttp/guzzle": "^7.8",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Default HTTP client (auto-discovered if installed)"
    },
    "autoload": {
        "psr-4": {
            "Identisure\\Client\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Identisure\\Client\\Tests\\": "php/tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c php/phpunit.xml",
        "check": [
            "php-cs-fixer fix --config=php/.php-cs-fixer.dist.php --dry-run --diff",
            "phpstan analyse -c php/phpstan.neon --no-progress --memory-limit=1G"
        ],
        "fix": "php-cs-fixer fix --config=php/.php-cs-fixer.dist.php"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
